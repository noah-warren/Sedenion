# Square roots of rationals stay exact. Square factors are pulled out, and a
# square root of a sum denests when the result is still a sum of square roots.

print(sqrt(8), "   ", sqrt(2) * sqrt(8), "   ", sqrt(2)^2)
print(sqrt(4 + 2*sqrt(3)))
print(1 / (sqrt(2) + sqrt(3)))
print(float(sqrt(2)))
